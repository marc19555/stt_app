# Copiez ce fichier vers .env.local. Ne commitez jamais .env.local.
HF_TOKEN=
DIARIZATION_ENABLED=false

# Genere automatiquement par install.ps1 si la valeur reste vide.
OLLAMA_PROXY_TOKEN=
OLLAMA_MODEL=granite4.1:3b
OLLAMA_FALLBACK_MODEL=qwen3.5:0.8b

# Provisionnement de la cle avec scripts/configure-usb.ps1.
USB_VOLUME_SERIAL=
USB_SECRET=
USB_SECRET_FILE=.stt-usb-token
USB_REQUIRE_BITLOCKER=true
